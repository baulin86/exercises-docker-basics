FROM ubuntu:24.04

WORKDIR /

RUN apt-get update && apt-get install -y curl
RUN curl -sL https://deb.nodesource.com/setup_16.x | bash
RUN apt install nodejs -y
RUN npm install -g serve

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build  
  
EXPOSE 5001


CMD ["serve", "-s", "-l", "5001", "--no-clipboard", "build"]




